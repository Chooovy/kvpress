{
  "model": "Qwen/Qwen3-8B",
  "tokenized": "data/longmino_tokenized",
  "out": "checkpoints/indexmem",
  "subsets": ["2e15", "2e16", "synth_cwe", "synth_rex"],
  "scorer": {
    "kind": "mlp",
    "mid_dim": 256,
    "norm_eps": 0.00001,
    "pos_slope": 0.000001,
    "gate_scale": true,
    "decay": true,
    "age_scale": 16384.0,
    "decay_init": -1.0
  },
  "schedule": "8192:300,16384:300",
  "objective": "reverse_kl",
  "ce_weight": 0.0,
  "teacher_cache": null,
  "gate_mass": 256.0,
  "sink_size": 4,
  "window_size": 128,
  "learning_rate": 0.001,
  "final_lr": 0.000005,
  "weight_decay": 0.0,
  "warmup_fraction": 0.1,
  "stable_fraction": 0.6,
  "batch_size": 1,
  "global_batch_size": 8,
  "ffn_sp_size": 8,
  "seed": 1000,
  "take_from": "head",
  "model_seed": 42,
  "workers": 2,
  "shuffle_buffer": 64,
  "chunk_size": 2048,
  "liger": true,
  "log_every": 10,
  "save_every": 100
}
