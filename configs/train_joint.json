{
  "model": "Qwen/Qwen3-8B",
  "tokenized": "data/longmino_tokenized",
  "out": "checkpoints/joint_ce",
  "subsets": ["2e16", "2e17"],
  "schedule": "8192:300",
  "objective": "ce",
  "gate_mass": 256.0,
  "sink_size": 4,
  "window_size": 128,
  "backbone_lr": 0.00002,
  "scorer_lr_multiplier": 5.0,
  "final_lr_fraction": 0.01,
  "batch_size": 1,
  "global_batch_size": 8,
  "ffn_sp_size": 8,
  "seed": 1000,
  "take_from": "head",
  "model_seed": 42,
  "workers": 2,
  "liger": true,
  "log_every": 10,
  "save_every": 100
}
